# ─────────────────────────────────────────────
# Flutter App Environment Config
# ─────────────────────────────────────────────

# App environment (development | staging | production)
APP_ENV=development

# App display name (optional — used in UI if needed)
APP_NAME=Leave Manager

# Firebase Config (Fill these in with your Firebase project details)
FIREBASE_ANDROID_API_KEY=your_api_key_here
FIREBASE_ANDROID_APP_ID=your_app_id_here
FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
